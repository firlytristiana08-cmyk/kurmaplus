{
  // Konfigurasi Cloudflare Workers untuk KURMAPLUS. Dibaca oleh
  // @sveltejs/adapter-cloudflare saat build (KURMAPLUS_ADAPTER=cloudflare)
  // dan oleh `npx wrangler deploy`. Jangan isi `main` — adapter menentukannya.
  "name": "kurmaplus",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  // Variabel lingkungan non-rahasia. Yang BERISI SANDI/KUNCI
  // (SUPABASE_DB_PASSWORD, DOKU_SECRET_KEY, DOKU_CLIENT_ID) JANGAN ditaruh di
  // sini — simpan di dasbor Cloudflare (Settings → Variables and Secrets),
  // pilih tipe SECRET agar tidak ditimpa deploy.
  // Deploy `wrangler deploy` menimpa variabel dasbor dengan isi blok ini —
  // semua var non-rahasia harus ada di sini (var DOKU menyusul bila perlu).
  "vars": {
    "SUPABASE_PROJECT_REF": "dmwtrtcehxjcweoanbsx",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_GWV5rs9AQat9BTn-yN7UZQ_DlANs5Qm",
    "SUPABASE_URL": "https://dmwtrtcehxjcweoanbsx.supabase.co"
  },
  // Hyperdrive = layanan pool + cache koneksi Supabase (disarankan).
  // Dibuat 22 Nov 2026 dari dasbor Cloudflare (Storage & Databases →
  // Hyperdrive → Connect database → public database). String koneksi pooler
  // Supabase tersimpan di konfigurasi Hyperdrive tersebut.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "1d5eb7ff8e964e1cac3ffd01efcec00f" }]
}
