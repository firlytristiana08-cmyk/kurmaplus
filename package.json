{
  "name": "kurmaplus-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "KURMAPLUS_ENV=dev vite build",
    "deploy:dev": "KURMAPLUS_ENV=dev vite build && npx wrangler deploy --config wrangler.dev.jsonc --name kurmaplus-dev",
    "prebuild": "node scripts/check-db.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@sveltejs/adapter-auto": "^8.0.1",
    "@sveltejs/adapter-cloudflare": "^9.0.0",
    "@sveltejs/adapter-vercel": "^7.0.5",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "leaflet": "^1.9.4",
    "pg": "^8.23.1",
    "valibot": "^1.5.0"
  }
}
